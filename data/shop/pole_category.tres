[gd_resource type="Resource" script_class="ShopCategory" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/resources/shop_category.gd" id="1_category"]
[ext_resource type="Script" path="res://scripts/resources/upgrade_data.gd" id="2_data"]
[ext_resource type="Resource" path="res://data/upgrades/light_pole.tres" id="3_light_pole"]
[ext_resource type="Resource" path="res://data/upgrades/pole_power.tres" id="4_pole_power"]
[ext_resource type="Resource" path="res://data/upgrades/pole_overclock.tres" id="5_pole_overclock"]
